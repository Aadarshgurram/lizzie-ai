# Vite bakes this in at BUILD time, not runtime. Before running `npm run build`
# for deployment, either copy this to `.env.production` and fill it in, or
# (cleaner) set VITE_API_URL as an environment variable in your hosting
# dashboard (Vercel/Netlify project settings) so it's not sitting in a file.
#
# Must be the full backend origin, no trailing slash, no /api suffix:
VITE_API_URL=https://your-backend-url.onrender.com
