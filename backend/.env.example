DATABASE_URL=sqlite:///./chatbot.db
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Leave empty to disable image understanding. Run `py check_models.py` to see which
# vision-capable models your Groq key can use.
GROQ_VISION_MODEL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: also allow Vercel preview URLs (regex), e.g. https://your-app(-[a-z0-9-]+)?\.vercel\.app
CORS_ORIGIN_REGEX=
# tiny | base | small | medium. Use "tiny" on a 512 MB free instance.
WHISPER_MODEL=base
# Max POSTs per minute per IP on /chat, /upload, /transcribe
RATE_LIMIT_PER_MIN=30
# Timezone for "what time is it" if the browser doesn't send one (servers usually run in UTC)
BOT_TIMEZONE=Asia/Kolkata
# --- Login (single user) ---
# Applied at startup: creates the user, or resets the password if it changed. Password: 10+ chars.
# After the first successful deploy you can delete ADMIN_PASSWORD from the host; the account stays.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Log out after this many minutes without activity, and after this many hours regardless.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# --- Assistant tools ---
# Optional: enables live web search (free tier at tavily.com). Leave empty to disable the tool.
TAVILY_API_KEY=
